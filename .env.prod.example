# ===========================================
# Home Ledger 生产自托管环境变量模板
# 复制为 .env.prod 后按需修改:
#   Windows: Copy-Item .env.prod.example .env.prod
#   Linux:   cp .env.prod.example .env.prod
# ===========================================

# ---------- PostgreSQL 数据库 ----------
POSTGRES_USER=home_ledger
# 强烈建议替换为随机密码（避免特殊字符如 @ : / # 以免影响连接串解析）
POSTGRES_PASSWORD=replace_with_a_strong_pg_password
POSTGRES_DB=home_ledger

# ---------- JWT 鉴权（生产环境必须 >= 32 位随机字符）----------
# PowerShell 生成命令: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# Linux/OpenSSL 命令: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_chars_random_hex_secret_key
JWT_EXPIRES_IN=7d

# ---------- 公网安全开关 ----------
# 首次部署设为 true 让家人注册账号；全部注册完毕后改为 false 并重启 api 容器即可禁止陌生人注册
ALLOW_REGISTRATION=true

# 允许跨域来源（一般保持与访问网址一致，多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:8080

# ---------- 本地访问入口 ----------
# 仅本机/Cloudflare Tunnel 访问保持 127.0.0.1；若希望家里局域网其他设备通过主机IP访问可改为 0.0.0.0
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
VITE_APP_TITLE=家庭财务管理系统

# ---------- Cloudflare Tunnel（远程访问必填）----------
# 在 Cloudflare Zero Trust -> Networks -> Tunnels 创建隧道后复制 Token 填入此处
CLOUDFLARE_TUNNEL_TOKEN=
