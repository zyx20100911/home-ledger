# ===========================================
# Home Ledger 家庭财务管理系统 - 环境变量示例
# 复制为 .env 后按需修改: cp .env.example .env
# ===========================================

# ---------- PostgreSQL (Docker Compose) ----------
POSTGRES_USER=home_ledger
POSTGRES_PASSWORD=home_ledger_dev_password
POSTGRES_DB=home_ledger
POSTGRES_PORT=5432

# ---------- Backend API (NestJS) ----------
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://home_ledger:home_ledger_dev_password@localhost:5432/home_ledger?schema=public"

# JWT 鉴权密钥 (生产环境请务必替换为强随机字符串)
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ---------- Frontend Web (Vue 3 + Vite) ----------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=家庭财务管理系统
